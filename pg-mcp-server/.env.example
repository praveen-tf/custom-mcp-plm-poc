# Postgres MCP server configuration. Copy to `.env` and fill in.
# All variables are namespaced with the PGMCP_ prefix.

# Connection string for the least-privilege, read-only role (see sql/role_setup.sql).
# The VM-hosted Postgres should require TLS; keep sslmode=require if SSL is configured.
PGMCP_DATABASE_URL=postgresql://mcp_readonly:CHANGE_ME@VM_HOST:5432/your_db?sslmode=require

# Access policy (table/column whitelist + templates).
PGMCP_POLICY_PATH=policy.yaml

# HTTP server (Streamable HTTP is served at /mcp/).
PGMCP_HOST=0.0.0.0
PGMCP_PORT=8000

# Query hardening.
PGMCP_STATEMENT_TIMEOUT_MS=5000
PGMCP_MAX_ROWS=200

# OAuth 2.1 — leave everything blank for local development (no auth; never expose publicly).
#
# Mode 1 — Azure OAuth proxy (preferred; required for the ChatGPT connector). FastMCP's
# AzureProvider publishes the OAuth discovery + dynamic-registration endpoints ChatGPT needs
# and proxies login to ONE Entra app registration. PGMCP_OAUTH_BASE_URL is this server's
# public HTTPS URL, no trailing slash (e.g. https://pg-mcp-server.<region>.azurecontainerapps.io).
PGMCP_OAUTH_CLIENT_ID=
PGMCP_OAUTH_CLIENT_SECRET=
PGMCP_OAUTH_TENANT_ID=
PGMCP_OAUTH_BASE_URL=
# Optional: defaults to api://<client_id>; set a stable signing key for multi-replica/restart.
PGMCP_OAUTH_IDENTIFIER_URI=
PGMCP_OAUTH_JWT_SIGNING_KEY=
#
# Mode 2 — token-only validation (resource server; validates JWTs, no discovery endpoints).
#   issuer  = https://login.microsoftonline.com/<tenant-id>/v2.0
#   jwks    = https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
#   audience= api://<app-id-uri>           (this server's resource identifier)
PGMCP_OAUTH_ISSUER_URL=
PGMCP_OAUTH_JWKS_URI=
PGMCP_OAUTH_AUDIENCE=
